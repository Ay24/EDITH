# ─────────────────────────────────────────────────────────────
# EDITH Cloud Mode — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.cloud and fill in your keys.
# Only GROQ_API_KEY is required. Everything else has defaults.

# ── Groq (required — free at https://console.groq.com) ──────
GROQ_API_KEY=your_groq_api_key_here

# ── HuggingFace (optional — for cloud RAG embeddings) ───────
# Free at https://huggingface.co/settings/tokens
HF_API_KEY=your_hf_api_key_here

# ── Cloud Model Overrides (optional) ────────────────────────
# EDITH_CLOUD_LLM_MODEL=llama-3.3-70b-versatile
# EDITH_CLOUD_FAST_MODEL=llama-3.1-8b-instant
# EDITH_CLOUD_VISION_MODEL=llama-3.2-90b-vision-preview
# EDITH_CLOUD_STT_MODEL=whisper-large-v3

# ── TTS Voice (optional — default: en-US-AriaNeural) ────────
# Available voices: en-US-AriaNeural, en-US-GuyNeural, en-US-JennyNeural
# EDITH_CLOUD_TTS_VOICE=en-US-AriaNeural
# EDITH_CLOUD_TTS_RATE=+5%

# ── Embedding Model (optional) ──────────────────────────────
# EDITH_CLOUD_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Fallback Behavior ───────────────────────────────────────
# Set to 0 to disable automatic Ollama fallback when cloud APIs fail
# EDITH_CLOUD_FALLBACK_OLLAMA=1
